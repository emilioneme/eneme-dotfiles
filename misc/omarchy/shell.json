{
  "bar": {
    "leftAnchor": "eneme.clock",
    "layout": {
      "center": [
        {
          "id": "eneme.workspaces"
        }
      ],
      "left": [
        {
          "id": "eneme.menu"
        },
        {
          "id": "eneme.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "eneme.weather"
        },
        {
          "id": "eneme.mediaplayer"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "eneme.tray"
        },
        {
          "id": "io.github.honeyspoons.localsend"
        },
        {
          "id": "io.github.xgborgeso.peripheral-batteries"
        },
        {
          "id": "io.github.olivoil.omarchy-keyboard-switcher"
        },
        {
          "id": "eneme.network"
        },
        {
          "id": "eneme.bluetooth"
        },
        {
          "id": "eneme.audio"
        },
        {
          "id": "eneme.monitor"
        },
        {
          "id": "eneme.power"
        },
        {
          "id": "eneme.lock"
        },
        {
          "id": "omarchy-stats"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "eneme.lock"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.media",
    "omarchy.lock",
    "omarchy.menu"
  ],
  "cloneSourceRestores": [
    "eneme.media",
    "eneme.lock",
    "eneme.menu"
  ]
}
